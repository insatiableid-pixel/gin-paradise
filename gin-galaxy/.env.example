# ─── Gin Paradise Environment Configuration ────────────────────────────

# NODE_ENV: Set to "production" to serve pre-built static files instead of Vite dev server.
# In production mode, run `npm run build` first, then `npm start`.
# NODE_ENV="production"

# PORT: HTTP server port. Default: 3000
# PORT=3000

# HOST: Bind address. Default: "0.0.0.0" (all interfaces).
# Use "127.0.0.1" if binding to localhost only (when behind a reverse proxy on the same host).
# HOST=0.0.0.0

# DATABASE_PATH: Absolute or relative path to the SQLite database file.
# Default: "./database.sqlite" (relative to the gin-galaxy/ directory).
# For persistent storage on platforms like Render or Railway, set this to a
# path on the persistent disk, e.g. "/data/database.sqlite".
# DATABASE_PATH="./database.sqlite"

# TRUST_PROXY: Enable Express trust-proxy for correct IP resolution behind reverse proxies.
# Required for accurate rate limiting and logging when deployed behind Render, Railway, Fly, nginx, etc.
# Values: "true" (trust all), "false" (off), "loopback" (trust localhost only), or a CIDR range.
# Default: "false"
# TRUST_PROXY="true"

# GEMINI_API_KEY: Required for AI-powered match analysis.
# Get one at https://aistudio.google.com/apikey
# Without this key, the analysis feature will return a graceful fallback message.
# This is completely optional — all gameplay features work without it.
GEMINI_API_KEY="your-gemini-api-key-here"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Only needed if the frontend is served from a different domain than the API.
# Leave empty for same-origin deployments (the default and recommended setup).
# ALLOWED_ORIGINS="https://ginparadise.example.com"

# Stripe billing. STRIPE_WEBHOOK_SECRET is mandatory whenever NODE_ENV=production;
# startup fails closed without it so forged webhook events cannot credit wallets.
# STRIPE_SECRET_KEY="sk_test_replace_me"
# STRIPE_WEBHOOK_SECRET="whsec_replace_me"
